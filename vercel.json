{
  "buildCommand": "node build-all.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/((?!assets/|.*\\.).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!admin/|assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
